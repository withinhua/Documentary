# Launcher side only. These never reach the rented machine.
VAST_API_KEY=
# Cloudflare R2 (S3-compatible, zero egress fees). Any S3-compatible store works.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=docburst
# Worker image pushed to a public registry (see worker/Dockerfile)
BURST_IMAGE=ghcr.io/<you>/docburst-worker:latest
